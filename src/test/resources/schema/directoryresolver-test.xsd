<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.nuxeo.org/ecm/schemas/directoryresolvertest/"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.nuxeo.org/ecm/schemas/directoryresolvertest/"
           xmlns:ref="http://www.nuxeo.org/ecm/schemas/core/external-references/">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string"/>
  </xs:simpleType>

  <xs:complexType name="drt_classificationType">
    <xs:sequence>
      <xs:element name="level">
        <xs:simpleType>
          <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory="LevelVocab"/>
        </xs:simpleType>
      </xs:element>
      <xs:element name="topics">
        <xs:simpleType>
          <xs:list>
            <xs:simpleType>
              <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory="TopicVocab"/>
            </xs:simpleType>
          </xs:list>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="title" type="xs:string"/>
  <xs:element name="tags" type="nxs:stringList"/>

  <!-- Inline list with no resolver: a multi-valued field with a format constraint -->
  <xs:element name="codes">
    <xs:simpleType>
      <xs:list>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:list>
    </xs:simpleType>
  </xs:element>

  <!-- Inline list of an item type, with no restriction -->
  <xs:element name="itemTypeList">
    <xs:simpleType>
      <xs:list itemType="xs:string"/>
    </xs:simpleType>
  </xs:element>

  <!-- Directory field -->
  <xs:element name="accessibility">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory="NXS7530SourceVocab"/>
    </xs:simpleType>
  </xs:element>

  <!-- Multi-valued Directory field -->
  <xs:element name="keywords">
    <xs:simpleType>
      <xs:list>
        <xs:simpleType>
          <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory="MyVocab"/>
        </xs:simpleType>
      </xs:list>
    </xs:simpleType>
  </xs:element>

  <!-- User/Group field -->
  <xs:element name="reviewer">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="userManagerResolver" ref:type="user"/>
    </xs:simpleType>
  </xs:element>

  <!-- Document field, given a directory parameter too: not a Directory field -->
  <xs:element name="otherResolverWithDirectory">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="documentResolver" ref:store="id" ref:directory="NotAVocab"/>
    </xs:simpleType>
  </xs:element>

  <!-- Complex field with a single and a multi-valued Directory sub-field -->
  <xs:element name="classification" type="nxs:drt_classificationType"/>

  <!-- directoryResolver with no directory, then with a blank one -->
  <xs:element name="noDirectory">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="directoryResolver"/>
    </xs:simpleType>
  </xs:element>
  <xs:element name="blankDirectory">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory=" "/>
    </xs:simpleType>
  </xs:element>

</xs:schema>
